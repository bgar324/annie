{
  "name": "annie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.8 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "dev:ui": "railway ssh config --alias annie-production && echo 'Open http://127.0.0.1:3001/' && ssh -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -N -L 127.0.0.1:3001:127.0.0.1:3001 annie-production",
    "start": "node dist/main.js",
    "smoke:inbound": "tsx scripts/smoke-inbound.ts",
    "test": "vitest run",
    "trace": "tsx src/cli.ts trace",
    "replay": "tsx src/cli.ts replay",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "fastify": "5.12.1",
    "googleapis": "176.0.0",
    "html-to-text": "10.0.1",
    "sendblue": "3.16.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.13.3",
    "railway": "^3.11.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
