# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
# SSH-tunneled control listener inside the authoritative runtime. Its host is fixed to 127.0.0.1.
LOCAL_UI_ENABLED=false
LOCAL_UI_PORT=3001

# Sendblue Free Sandbox
# Verify USER_PHONE_NUMBER in Sendblue, then text SENDBLUE_FROM_NUMBER once before starting.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=
SENDBLUE_BASE_URL=https://api.sendblue.co
USER_PHONE_NUMBER=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_REQUEST_TIMEOUT_MS=90000

# Google Workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion hosted MCP
NOTION_MCP_URL=https://mcp.notion.com/mcp

# Daily brief at 08:00 America/Los_Angeles
DAILY_BRIEF_ENABLED=false

# Generate once with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Local storage. In production, set RAILWAY_VOLUME_MOUNT_PATH=/app/data instead.
# RAILWAY_VOLUME_MOUNT_PATH=/app/data
# DATA_DIR=./data
# DATABASE_PATH=assistant.sqlite
# MEMORY_PATH=MEMORY.md
# TRACE_DIR=traces
# TRACE_RETENTION_DAYS=30
# TRACE_MAX_BYTES=536870912

# Operational limits
# MAX_AGENT_TOOL_ROUNDS=6
# MAX_AGENT_RUN_MS=120000
# MAX_AGENT_TOOL_CALLS=16
# MAX_AGENT_WRITES=2
# MEMORY_MAX_BYTES=16384
# RECENT_MESSAGE_LIMIT=20
# WORKER_POLL_MS=250
# JOB_LEASE_MS=180000
# MAX_PENDING_JOBS=256
# OAUTH_LINK_TTL_MS=600000
# PROVIDER_REQUEST_TIMEOUT_MS=30000
